#!/usr/bin/env bash
# Auto-formats staged files with Prettier before every commit, so nothing
# unformatted ever gets committed. Installed via `git config core.hooksPath
# .githooks` (done automatically by `npm install`/`npm ci`, see package.json
# "prepare" script).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

staged_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.html' '*.css' '*.js' '*.json' '*.md')

if [ -z "$staged_files" ]; then
  exit 0
fi

echo "Running Prettier on staged files..."
echo "$staged_files" | xargs npx --no-install prettier --write

# Re-stage anything Prettier touched so the fix is part of this commit.
echo "$staged_files" | xargs git add
