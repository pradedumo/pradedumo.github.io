{
  "name": "pradedumo-portfolio",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "format:check": "prettier --check \"index.html\" \"css/**/*.css\" \"js/**/*.js\" \"tests/**/*.js\" \"playwright.config.js\"",
    "format": "prettier --write \"index.html\" \"css/**/*.css\" \"js/**/*.js\" \"tests/**/*.js\" \"playwright.config.js\"",
    "lint:html": "htmlhint index.html",
    "test": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "htmlhint": "1.1.4",
    "prettier": "3.3.3"
  }
}
